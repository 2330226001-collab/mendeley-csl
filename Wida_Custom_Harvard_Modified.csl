<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text">
  <info>
    <title>Wida Custom - Harvard Modified Book Chapter</title>
    <title-short>Wida Custom</title-short>
    <id>http://www.zotero.org/styles/wida-custom-harvard-modified</id>
    <link href="http://www.zotero.org/styles/wida-custom-harvard-modified" rel="self"/>
    <updated>2026-10-21T00:00:00+00:00</updated>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="page" form="short">P.</term>
      <term name="editor">Edited by</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text"/>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text"/>
      <label prefix=" Edited by " form="long"/>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title" font-style="normal"/>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="issued"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false">
    <sort>
      <key variable="author"/>
      <key variable="issued"/>
    </sort>
    <layout suffix=".">
      <text macro="author"/>
      <text macro="issued" prefix=" "/>
      <text macro="title" prefix=". "/>
      <text variable="container-title" prefix="; "/>
      <text variable="edition" prefix=", " suffix="th Ed."/>
      <text macro="editor" prefix=". "/>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <text variable="page" prefix=". P. "/>
    </layout>
  </bibliography>
</style>
